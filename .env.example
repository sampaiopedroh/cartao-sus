# ==========================================================
# Cartão SUS Inteligente — variáveis de ambiente
# Copie para .env e preencha. O arquivo .env NUNCA vai para o git.
# ==========================================================

# --- Banco de dados (F0) ---
# Senha do usuário root do MySQL. Obrigatória.
MYSQL_ROOT_PASSWORD=
# Porta exposta no seu computador. Troque se a 3306 já estiver em uso.
MYSQL_PORT=3306
# Senha do usuario cartao_app (usado pela API). Obrigatoria.
MYSQL_APP_PASSWORD=

# --- Backend (F2) ---
# Chave de assinatura do JWT (HS256). Mínimo de 32 caracteres (256 bits).
JWT_SECRET=
# Senha dos usuários de demonstração, gravada pelo seeder na primeira execução.
SENHA_DEMO=
# true = o backend preenche senhas e segredos TOTP demo na primeira execução.
SEED_DEMO=true

# --- IoT (F6) ---
# Endereço da API usado pelos scripts Python.
API_URL=http://localhost:8080
# CNES da UBS usada na demonstração (UBS Jardim Colombo). Valor público.
CNES_UBS=9186492
# Chaves dos dispositivos. Geradas por iot/gerar_chaves.py. Deixe vazio.
IOT_KEY_TERMINAL_UBS=
IOT_KEY_TERMINAL_UPA=
IOT_KEY_TENSIOMETRO=
