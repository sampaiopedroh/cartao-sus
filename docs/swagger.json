  "components": {
    "schemas": {
      "AlertaCritico": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "nullable": true
          },
          "substancia": {
            "type": "string",
            "nullable": true
          },
          "severidade": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AlertaDisparado": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "nullable": true
          },
          "mensagem": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AtualizarHistoricoRequest": {
        "required": [
          "descricao",
          "grauSeveridade"
        ],
        "type": "object",
        "properties": {
          "descricao": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "grauSeveridade": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CadastroRequest": {
        "required": [
          "cpf",
          "dataNascimento",
          "login",
          "nomeCompleto",
          "numeroCns",
          "senha"
        ],
        "type": "object",
        "properties": {
          "login": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "minLength": 8,
            "type": "string"
          },
          "cpf": {
            "minLength": 1,
            "pattern": "^\\d{11}$",
            "type": "string"
          },
          "numeroCns": {
            "minLength": 1,
            "pattern": "^\\d{15}$",
            "type": "string"
          },
          "nomeCompleto": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "dataNascimento": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "CadastroResponse": {
        "type": "object",
        "properties": {
          "idCidadao": {
            "type": "integer",
            "format": "int64"
          },
          "segredoTotp": {
            "type": "string",
            "nullable": true
          },
          "mensagem": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DocumentoCriadoResposta": {
        "type": "object",
        "properties": {
          "idDocumento": {
            "type": "integer",
            "format": "int64"
          },
          "mensagem": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DocumentoRequest": {
        "required": [
          "hashIntegridade",
          "nomeArquivo",
          "tipoDocumento"
        ],
        "type": "object",
        "properties": {
          "tipoDocumento": {
            "minLength": 1,
            "type": "string"
          },
          "nomeArquivo": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "hashIntegridade": {
            "minLength": 1,
            "pattern": "^[a-fA-F0-9]{64}$",
            "type": "string"
          },
          "dataValidade": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "login",
          "senha"
        ],
        "type": "object",
        "properties": {
          "login": {
            "minLength": 1,
            "type": "string"
          },
          "senha": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "tipo": {
            "type": "string",
            "nullable": true
          },
          "expiraEmMinutos": {
            "type": "integer",
            "format": "int32"
          },
          "perfil": {
            "type": "string",
            "nullable": true
          },
          "idCidadao": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "nome": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "idUsuario": {
            "type": "integer",
            "format": "int64"
          },
          "login": {
            "type": "string",
            "nullable": true
          },
          "perfil": {
            "type": "string",
            "nullable": true
          },
          "idCidadao": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PacienteResumo": {
        "type": "object",
        "properties": {
          "nomeCompleto": {
            "type": "string",
            "nullable": true
          },
          "cns": {
            "type": "string",
            "nullable": true
          },
          "documentosDisponiveis": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "alertasCriticos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertaCritico"
            },
            "nullable": true
          },
          "ultimasMedicoes": {
            "$ref": "#/components/schemas/UltimasMedicoes"
          }
        },
        "additionalProperties": false
      },
      "SinalVitalRequest": {
        "required": [
          "tipoMedicao",
          "valor"
        ],
        "type": "object",
        "properties": {
          "tipoMedicao": {
            "minLength": 1,
            "type": "string"
          },
          "valor": {
            "type": "number",
            "format": "double"
          },
          "dataHora": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "numeroCns": {
            "pattern": "^\\d{15}$",
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SinalVitalResposta": {
        "type": "object",
        "properties": {
          "idSinal": {
            "type": "integer",
            "format": "int64"
          },
          "alertaDisparado": {
            "type": "boolean"
          },
          "alerta": {
            "$ref": "#/components/schemas/AlertaDisparado"
          }
        },
        "additionalProperties": false
      },
      "UltimasMedicoes": {
        "type": "object",
        "properties": {
          "glicemia": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pressaoArterial": {
            "type": "string",
            "nullable": true
          },
          "dataRegistro": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidarNfcRequest": {
        "required": [
          "codigoCnesUnidade",
          "numeroCns",
          "tokenRotativo"
        ],
        "type": "object",
        "properties": {
          "numeroCns": {
            "minLength": 1,
            "pattern": "^\\d{15}$",
            "type": "string"
          },
          "codigoCnesUnidade": {
            "minLength": 1,
            "pattern": "^\\d{7}$",
            "type": "string"
          },
          "tokenRotativo": {
            "minLength": 1,
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ValidarNfcResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          },
          "mensagem": {
            "type": "string",
            "nullable": true
          },
          "paciente": {
            "$ref": "#/components/schemas/PacienteResumo"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Token obtido em POST /api/v1/auth/login",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ApiKey": {
        "type": "apiKey",
        "description": "Chave do dispositivo IoT (terminal NFC ou tensiômetro)",
        "name": "X-API-KEY",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "Acolhimento"
    },
    {
      "name": "Admin"
