        {
          "name": "Cadastro de novo cidadão",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CPF (com dígitos verificadores) e CNS novos a cada execução, para a coleção poder rodar várias vezes.",
                  "const rnd = n => Array.from({length: n}, () => Math.floor(Math.random() * 10));",
                  "const dv = a => { let s = 0; for (let i = 0; i < a.length; i++) s += a[i] * (a.length + 1 - i); const r = (s * 10) % 11; return r === 10 ? 0 : r; };",
                  "const c = rnd(9); c.push(dv(c)); c.push(dv(c));",
                  "pm.collectionVariables.set('cpfNovo', c.join(''));",
                  "pm.collectionVariables.set('cnsNovo', '7' + rnd(14).join(''));",
                  "pm.collectionVariables.set('loginNovo', 'novo.' + Date.now() + '@cartaosus.demo');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('segredo TOTP devolvido uma única vez', () => pm.expect(pm.response.json().segredoTotp).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "cadastro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{loginNovo}}\",\n  \"senha\": \"SenhaForte123\",\n  \"cpf\": \"{{cpfNovo}}\",\n  \"numeroCns\": \"{{cnsNovo}}\",\n  \"nomeCompleto\": \"Cidadao Postman\",\n  \"dataNascimento\": \"1990-05-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
