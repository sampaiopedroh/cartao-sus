{
  "info": {
    "name": "Cartão SUS Inteligente API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção da API Cartão SUS Inteligente (F9). Exemplos de corpo e testes automáticos de status. Antes de rodar: defina senhaDemo (SENHA_DEMO do .env), chaveDispositivo (IOT_KEY_* do .env) quando usar X-API-KEY, e rode o login primeiro para preencher token. Ordem sugerida: login, me, prontuário, documentos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "chaveDispositivo",
      "value": ""
    },
    {
      "key": "senhaDemo",
      "value": "<defina a SENHA_DEMO do seu .env>"
    },
    {
      "key": "codigoTotp",
      "value": "<código do app ou do gerador>"
    }
  ],
  "item": [
    {
      "name": "/api/v1/acolhimento/validar-nfc",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/acolhimento/validar-nfc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "acolhimento",
            "validar-nfc"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numeroCns\": \"898000000000000\",\n  \"codigoCnesUnidade\": \"9186492\",\n  \"tokenRotativo\": \"{{codigoTotp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
